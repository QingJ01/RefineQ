# Backend
REFINEQ_DATA_ROOT=/data
REFINEQ_HOST=0.0.0.0
REFINEQ_PORT=8000
# Compose keeps the API private behind Caddy, so forwarded headers may be trusted from that hop.
# Restrict this to explicit proxy IPs/CIDRs if the API port is exposed directly.
REFINEQ_FORWARDED_ALLOW_IPS=*

# PostgreSQL + pgvector. Keep the password and URL in sync. URL-encode special
# characters when constructing REFINEQ_DATABASE_URL.
REFINEQ_POSTGRES_DB=refineq
REFINEQ_POSTGRES_USER=refineq
REFINEQ_POSTGRES_PASSWORD=refineq-local-change-me
REFINEQ_DATABASE_URL=postgresql+psycopg://refineq:refineq-local-change-me@database:5432/refineq

# Model security. Generate a Fernet key for public deployments with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep the key outside backups and reuse it across upgrades. Leave empty only for local development.
REFINEQ_MODEL_ENCRYPTION_KEY=
REFINEQ_MODEL_ENDPOINT_ALLOWED_HOSTS=api.openai.com,api.deepseek.com,api.siliconflow.cn
# Required before enabling S3. Add only operator-controlled endpoint hostnames.
REFINEQ_OBJECT_STORAGE_ENDPOINT_ALLOWED_HOSTS=

# Per-user storage and object quotas
REFINEQ_MATERIAL_MAX_COUNT_PER_USER=500
REFINEQ_MATERIAL_MAX_BYTES_PER_USER=2147483648
REFINEQ_MATERIAL_MAX_REQUEST_BYTES=54525952
REFINEQ_MATERIAL_UPLOAD_MAX_CONCURRENT_GLOBAL=2
REFINEQ_MATERIAL_UPLOAD_MAX_CONCURRENT_PER_USER=1
REFINEQ_MATERIAL_UPLOAD_BODY_IDLE_TIMEOUT_SECONDS=10
REFINEQ_MATERIAL_UPLOAD_BODY_TOTAL_TIMEOUT_SECONDS=60
REFINEQ_MATERIAL_MAX_PDF_PAGES=500
REFINEQ_MATERIAL_MAX_DOCX_ENTRIES=2000
REFINEQ_MATERIAL_MAX_DOCX_EXPANDED_BYTES=104857600
REFINEQ_MATERIAL_MAX_DOCX_COMPRESSION_RATIO=100
REFINEQ_MATERIAL_MAX_EXTRACTED_CHARS=2000000
REFINEQ_MATERIAL_EXTRACTION_TIMEOUT_SECONDS=15
REFINEQ_MATERIAL_OCR_MAX_PAGES=50
REFINEQ_MATERIAL_OCR_MAX_IMAGES_PER_REQUEST=4
REFINEQ_MATERIAL_OCR_MAX_PAGE_PIXELS=12000000
REFINEQ_MATERIAL_OCR_MAX_TOTAL_PIXELS=80000000
REFINEQ_MATERIAL_OCR_MAX_IMAGE_BYTES=41943040
REFINEQ_MAX_WORKSPACES_PER_USER=100
REFINEQ_MAX_PROJECTS_PER_USER=100
REFINEQ_MAX_AGENT_SESSIONS_PER_USER=200

# Account recovery tokens must be delivered out-of-band in public deployments.
# Set true only for an isolated local demo that has no email provider.
REFINEQ_PASSWORD_RESET_EXPOSE_TOKEN=false

# Abuse protection (requests per window)
REFINEQ_AUTH_RATE_LIMIT_REQUESTS=30
REFINEQ_MUTATION_RATE_LIMIT_REQUESTS=240
REFINEQ_RATE_LIMIT_WINDOW_SECONDS=60

# Web server and reverse proxy
REFINEQ_API_ORIGIN=http://api:8000
# Public browser URL used for social preview metadata during the web image build.
REFINEQ_PUBLIC_SITE_URL=http://localhost
REFINEQ_DOMAIN=:80
REFINEQ_HTTP_PORT=80
REFINEQ_HTTPS_PORT=443
