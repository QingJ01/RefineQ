{
    admin off
}

{$REFINEQ_DOMAIN::80} {
    encode zstd gzip

    handle /health/* {
        reverse_proxy api:8000
    }

    handle /mcp {
        request_body {
            max_size 131072
        }
        reverse_proxy api:8000 {
            flush_interval -1
            transport http {
                dial_timeout 5s
                response_header_timeout 25s
            }
        }
    }

    handle /api/mcp {
        respond "Not Found" 404
    }

    handle /api/mcp/* {
        respond "Not Found" 404
    }

    handle_path /api/* {
        request_body {
            max_size {$REFINEQ_MATERIAL_MAX_REQUEST_BYTES:54525952}
        }
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy web:3000
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}
